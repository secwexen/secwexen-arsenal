root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Markdown documentation
[*.md]
trim_trailing_whitespace = false

# Python source code, scripts and tests
[*.py]
indent_style = space
indent_size = 4

# Python project configuration
[*.toml]
indent_style = space
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
indent_size = tab
tab_width = 4
